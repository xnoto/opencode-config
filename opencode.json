  },
  "mcp": {
    "apify": {
      "type": "remote",
      "url": "http://127.0.0.1:8783/mcp",
      "enabled": false,
      "oauth": false
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "aws-staging": {
      "type": "remote",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 100000
    },
    "aws-prod": {
      "type": "remote",
      "url": "http://127.0.0.1:8766/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 100000
    },
    "aws-docs": {
      "type": "remote",
      "url": "http://127.0.0.1:8767/mcp",
      "enabled": true,
      "oauth": false
    },
    "grafana": {
      "type": "remote",
      "url": "http://127.0.0.1:8768/mcp",
      "enabled": true,
      "oauth": false
    },
    "agent-hub": {
      "type": "remote",
      "url": "http://127.0.0.1:8776/mcp",
      "enabled": true,
      "oauth": false
    },
    "tmux": {
      "type": "remote",
      "url": "http://127.0.0.1:8770/mcp",
      "enabled": true,
      "oauth": false
    },
    "terraform-docs": {
      "type": "remote",
      "url": "http://127.0.0.1:8771/mcp",
      "enabled": true,
      "oauth": false
    },
    "opentofu-docs": {
      "type": "remote",
      "url": "https://mcp.opentofu.org/mcp",
      "enabled": true
    },
    "opencode-docs": {
      "type": "remote",
      "url": "http://127.0.0.1:8773/mcp",
      "enabled": true,
      "oauth": false
    },
    "mcp-gateway": {
      "type": "remote",
      "url": "https://mcp.makeitwork.cloud/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "CF-Access-Client-Id": "{env:CF_ACCESS_CLIENT_ID}",
        "CF-Access-Client-Secret": "{env:CF_ACCESS_CLIENT_SECRET}"
      }
    },
    "parallel-search": {
      "type": "remote",
      "url": "http://127.0.0.1:8782/mcp",
      "enabled": true,
      "oauth": false
    },
    "argocd-staging-eks": {
      "type": "remote",
      "url": "http://127.0.0.1:8774/mcp",
      "enabled": true,
      "oauth": false
